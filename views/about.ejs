<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("partial/head", { title: "About", css: "about.css" }); %>
</head>
<body>
    <%- include("partial/header"); %>

    <main class="page">
        <p class="section-tag">// education</p>
        <h2 class="section-title"><span class="plain">My</span> Education</h2>

        <section class="education">
            <% education.forEach(item => { %>
                <div class="timeline-item">
                    <div class="timeline-icon">🎓</div>

                    <div class="timeline-card spot">
                        <div class="meta">
                            <span>📅 <%= item.year %></span>
                            <span>📍 <%= item.location %></span>
                        </div>

                        <h3><%= item.title %></h3>
                        <h4><%= item.institute %></h4>

                        <p><%- item.description.replace(/\n/g, "<br>") %></p>
                    </div>
                </div>
            <% }) %>
        </section>
    </main>

    <%- include("partial/footer"); %>
</body>
</html>
