<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("partial/head", { title: "Projects", css: "projects.css" }); %>
</head>
<body>
    <%- include("partial/header"); %>

    <main class="page">
        <p class="section-tag">// projects</p>
        <h2 class="section-title"><span class="plain">My</span> Projects</h2>

        <div class="projects_container">
            <% for (let i = 0; i < projects.length; i++) { %>
                <article class="project_card spot">
                    <p class="project_type"><%= projects[i].type %></p>
                    <h3 class="project_title"><%= projects[i].title %></h3>
                    <p class="project_desc"><%= projects[i].description %></p>
                    <div class="project_tags">
                        <% for (let j = 0; j < projects[i].tech_stack.length; j++) { %>
                            <span class="tag"><%= projects[i].tech_stack[j].trim() %></span>
                        <% } %>
                    </div>
                    <div class="livelinks">
                        <% if (projects[i].livelink) { %>
                            <a href="<%= projects[i].livelink %>" class="project_link" target="_blank" rel="noopener noreferrer">View Project</a>
                        <% } %>
                    </div>
                </article>
            <% } %>
        </div>
    </main>

    <%- include("partial/footer"); %>
</body>
</html>
