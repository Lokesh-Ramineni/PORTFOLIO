<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("partial/head", { title: "Skills", css: "skills.css" }); %>
</head>
<body>
    <%- include("partial/header"); %>

    <main class="page">
        <p class="section-tag">// skills</p>
        <h2 class="section-title"><span class="plain">My</span> Technical Skills</h2>

        <div class="spaces">
            <% for (let i = 0; i < technical_skills.length; i++) { %>
                <div class="skills_container spot">
                    <h3 class="skills_heading"><%= headings[i] %></h3>
                    <div class="skills_row">
                        <% technical_skills[i].forEach(tech => { %>
                            <div class="tech_stack">
                                <img src="<%= tech.img_src %>" alt="<%= tech.name %>" loading="lazy">
                                <p><%= tech.name %></p>
                            </div>
                        <% }); %>
                    </div>
                </div>
            <% } %>
        </div>
    </main>

    <%- include("partial/footer"); %>
</body>
</html>
